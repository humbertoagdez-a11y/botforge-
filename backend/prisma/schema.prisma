generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WaConnectionStatus {
  PENDING
  ACTIVE
  EXPIRED
}

enum Plan {
  FREE
  STARTER
  PRO
  AGENCY
}

enum DocumentStatus {
  PENDING
  PROCESSING
  READY
  ERROR
}

enum MessageRole {
  USER
  ASSISTANT
}

model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  passwordHash          String
  name                  String
  plan                  Plan      @default(FREE)
  stripeCustomerId      String?   @unique
  stripeSubscriptionId  String?   @unique
  planExpiresAt         DateTime?
  /// CI o RUC. Opcional: solo hace falta para pagar, Pagopar lo exige.
  /// No se pide en el registro, se pide al ir al checkout.
  documento             String?
  /// Sin verificar no hay sesion: el registro no devuelve tokens hasta
  /// confirmar el codigo. Los usuarios previos al deploy quedan en true
  /// via la migracion, para no dejarlos afuera.
  emailVerified         Boolean   @default(false)
  emailVerifiedAt       DateTime?
  messagesUsedThisMonth Int       @default(0)
  messagesResetAt       DateTime  @default(now())
  /// Cupo del asistente de plataforma (Agente Tipo A), por plan
  assistantMsgsThisMonth Int      @default(0)
  assistantMsgsToday     Int      @default(0)
  assistantResetAt       DateTime @default(now())
  assistantDayResetAt    DateTime @default(now())
  dailySummaryEnabled   Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  bots                     Bot[]
  refreshTokens            RefreshToken[]
  passwordResetTokens      PasswordResetToken[]
  emailVerificationCodes   EmailVerificationCode[]
  notificationConfigs      NotificationConfig[]
  platformAssistantMessages PlatformAssistantMessage[]
  pagoparOrders            PagoparOrder[]

  @@map("users")
}

/// Pedido de pago en Pagopar. Flujo simple (pago unico, no recurrente):
/// se crea antes de mandar al cliente al checkout y lo marca pagado el
/// webhook, siempre despues de validar el token sha1.
model PagoparOrder {
  id               String    @id @default(uuid())
  userId           String
  plan             String
  montoTotal       Int
  /// Lo devuelve Pagopar al iniciar la transaccion; identifica el pedido
  hashPedido       String?   @unique
  /// Nuestro identificador, el que viaja en el token de la firma
  idPedidoComercio String    @unique
  pagado           Boolean   @default(false)
  fechaPago        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("pagopar_orders")
}

model PlatformAssistantMessage {
  id        String   @id @default(uuid())
  userId    String
  role      String // 'user' | 'assistant'
  content   String   @db.Text
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("platform_assistant_messages")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

/// Codigo de 6 digitos para verificar el email al registrarse. Vive 15
/// minutos, admite hasta 5 intentos fallidos y al pedir uno nuevo se
/// invalidan los anteriores del mismo usuario.
model EmailVerificationCode {
  id        String    @id @default(uuid())
  userId    String
  code      String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_codes")
}

/// Token de un solo uso para resetear la contraseña. Vive 1 hora.
/// Al generar uno nuevo se marcan como usados los anteriores del mismo usuario,
/// asi que solo el ultimo link enviado sirve.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Bot {
  id             String   @id @default(uuid())
  userId         String
  name           String
  personality    String   @default("Eres un asistente útil y amigable.")
  language       String   @default("es")
  whatsappNumber String?  @unique
  // Meta Cloud API: id del numero de negocio que recibe los mensajes.
  // Es la clave de ruteo de Meta, distinta del numero del cliente que guarda
  // whatsappNumber (flujo Twilio). Se mantienen separados para poder volver
  // atras a Twilio sin perder el vinculo.
  metaPhoneNumberId String? @unique
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents           Document[]
  conversations       Conversation[]
  whatsappConnections WhatsAppConnection[]
  notificationConfigs NotificationConfig[]
  driveConnection     DriveConnection?

  @@map("bots")
}

model DriveConnection {
  id           String    @id @default(uuid())
  botId        String    @unique
  accessToken  String
  refreshToken String
  expiresAt    DateTime?
  folderName   String    @default("catálogo")
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@map("drive_connections")
}

model NotificationConfig {
  id        String   @id @default(uuid())
  userId    String
  botId     String
  event     String // 'human_requested' | 'new_conversation' | 'daily_summary'
  email     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  bot  Bot  @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@unique([botId, event])
  @@map("notification_configs")
}

model WhatsAppConnection {
  id               String             @id @default(uuid())
  botId            String
  phoneNumber      String
  verificationCode String             @unique
  status           WaConnectionStatus @default(PENDING)
  createdAt        DateTime           @default(now())
  expiresAt        DateTime

  bot              Bot                @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@map("whatsapp_connections")
}

model Document {
  id         String         @id @default(uuid())
  botId      String
  name       String
  mimeType   String
  filePath   String
  url        String?
  fileSize   Int
  status     DocumentStatus @default(PENDING)
  errorMsg   String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  bot        Bot     @relation(fields: [botId], references: [id], onDelete: Cascade)
  chunks     Chunk[]

  @@map("documents")
}

model Chunk {
  id           String   @id @default(uuid())
  documentId   String
  botId        String
  content      String
  tokenCount   Int
  chunkIndex   Int
  pineconeId   String   @unique
  createdAt    DateTime @default(now())

  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("chunks")
}

model Conversation {
  id          String   @id @default(uuid())
  botId       String
  channelId   String
  channel     String   @default("web")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bot         Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@unique([botId, channelId])
  @@map("conversations")
}

model Message {
  id             String      @id @default(uuid())
  conversationId String
  role           MessageRole
  content        String
  tokensUsed     Int         @default(0)
  createdAt      DateTime    @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("messages")
}
